// The app's Windows resources, linked into vessel-app.exe by build.sh
// (llvm-rc, then lld-link): the icon Explorer, the taskbar and Alt+Tab
// show, and the version block Task Manager and the file's properties
// read ("Vessel", not the binary's name). {VERSION} is the label's last
// four numbers, which a version block can hold; {LABEL} the label itself.
// GPUI links its own manifest resource; the two do not overlap.

1 ICON "vessel.ico"

1 VERSIONINFO
FILEVERSION {VERSION}
PRODUCTVERSION {VERSION}
FILEFLAGSMASK 0x3f
FILEFLAGS 0x0
FILEOS 0x40004
FILETYPE 0x1
FILESUBTYPE 0x0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Team-WICKED"
            VALUE "FileDescription", "Vessel"
            VALUE "FileVersion", "{LABEL}"
            VALUE "InternalName", "vessel-app"
            VALUE "LegalCopyright", "Team-WICKED"
            VALUE "OriginalFilename", "Vessel.exe"
            VALUE "ProductName", "Vessel"
            VALUE "ProductVersion", "{LABEL}"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
