## 설정 › 플러그인(ADR 0115): 머신의 플러그인. Paseo의 settings.plugins.* 문구를
## 따르고 Paseo의 "호스트"는 "머신"으로 씁니다. $id는 "night" 같은 설치 ID입니다.

# 페이지 카드들 위의 섹션 제목. 짧게 씁니다.
plugins-title = 플러그인

# 페이지 맨 위 경고의 제목.
plugins-trusted-title = 플러그인은 신뢰하는 코드입니다

# 경고 제목 아래의 설명.
plugins-trusted-description = 이 머신에서 격리 없이 실행됩니다. 신뢰하는 코드만 설치하세요.

# 머신 전체 스위치 행의 제목. 짧게 씁니다.
plugins-global-title = 플러그인 활성화

# 머신 전체 스위치 아래의 힌트.
plugins-global-hint = 설정된 모든 플러그인의 전역 스위치

# 설치 입력란 위의 이름. 짧게 씁니다.
plugins-source-label = 플러그인 소스

# 설치 입력란의 자리 표시자: 이 프로토콜이 설치하는 유일한 소스.
plugins-source-placeholder = 이 머신의 디렉터리, ~/… 또는 /…

# 입력란의 소스를 설치하는 버튼. 짧게 씁니다.
plugins-install = 플러그인 설치

# 설치하는 동안의 설치 버튼. 짧게 씁니다.
plugins-installing = 설치 중…

# 실행 중인 플러그인의 상태 배지. 짧게 씁니다.
plugins-status-running = 실행 중

# 비활성화된 플러그인의 상태 배지. 짧게 씁니다.
plugins-status-disabled = 비활성화

# 시작하지 못한 플러그인의 상태 배지. 짧게 씁니다.
plugins-status-failed = 실패

# 행의 "…" 메뉴 이름이자 휴대폰에서 시트의 제목. $id는 설치입니다.
plugins-menu = { $id } 작업

# 플러그인이 꺼져 있을 때 행 스위치의 음성 이름: 누르면 하는 일.
plugins-switch-enable = { $id }: 활성화

# 플러그인이 켜져 있을 때 행 스위치의 음성 이름.
plugins-switch-disable = { $id }: 비활성화

# 플러그인을 디스크에서 다시 로드하는 메뉴 행. 짧게 씁니다.
plugins-reload = 다시 로드

# 다시 로드하는 동안의 행. 짧게 씁니다.
plugins-reloading = 다시 로드 중…

# 플러그인을 제거하는 메뉴 행이자 확인 창의 버튼. 짧게 씁니다.
plugins-remove = 제거

# 제거하는 동안의 행. 짧게 씁니다.
plugins-removing = 제거 중…

# 플러그인의 로그를 여는 메뉴 행. 짧게 씁니다.
plugins-logs = 로그

# 설치한 뒤의 알림. $id는 만든 설치입니다.
plugins-installed = { $id } 설치됨

# 다시 로드한 뒤의 알림.
plugins-reloaded = { $id } 다시 로드됨

# 플러그인 스위치를 켠 뒤의 알림.
plugins-enabled = { $id } 활성화됨

# 플러그인 스위치를 끈 뒤의 알림.
plugins-disabled = { $id } 비활성화됨

# 제거한 뒤의 알림.
plugins-removed = { $id } 제거됨

# 제거를 취소한 뒤의 알림.
plugins-kept = { $id } 유지됨

# 머신 전체 스위치를 켠 뒤의 알림.
plugins-global-enabled = 플러그인 활성화됨

# 머신 전체 스위치를 끈 뒤의 알림.
plugins-global-disabled = 플러그인 비활성화됨

# 제거 확인 창의 제목.
plugins-remove-title = { $id }{ PARTICLE($id, "object") } 제거할까요?

# 제거 확인 창의 설명.
plugins-remove-message = 설정만 제거합니다. 소스 디렉터리는 삭제되지 않습니다.

# 플러그인을 그대로 두는 확인 창의 버튼. 짧게 씁니다.
plugins-cancel = 취소

# 머신이 연결되어 있지 않을 때의 경고 제목.
plugins-offline-title = 플러그인 호스트가 오프라인입니다

# 그 아래의 설명.
plugins-offline-description = 플러그인을 관리하려면 이 머신에 다시 연결하세요.

# 머신의 Vessel이 플러그인 호출보다 오래되었을 때의 경고 제목.
plugins-update-title = 플러그인을 관리하려면 이 머신을 업데이트하세요

# 목록을 처음 읽는 동안.
plugins-loading = 플러그인 로드 중…

# 목록을 읽지 못했을 때의 오류 제목. 이유가 뒤따릅니다.
plugins-error-title = 플러그인을 로드할 수 없습니다

# 목록을 다시 읽는 버튼. 짧게 씁니다.
plugins-retry = 다시 시도

# 설치된 것이 없을 때.
plugins-empty = 설정된 플러그인이 없습니다

# 행의 소스 줄. $path는 머신의 디렉터리입니다.
plugins-directory = 디렉터리: { $path }

# 플러그인 로그 창의 제목.
plugins-logs-title = 로그: { $id }

# 첫 응답 전의 로그 창.
plugins-logs-loading = 로그 로드 중…

# 로그를 다시 읽는 버튼. 짧게 씁니다.
plugins-logs-refresh = 새로 고침

# 다시 읽는 동안의 새로 고침 버튼. 짧게 씁니다.
plugins-logs-refreshing = 새로 고치는 중…

# 로그를 읽지 못했을 때의 오류 제목. 이유가 뒤따릅니다.
plugins-logs-error-title = 플러그인 로그를 로드할 수 없습니다

# 플러그인이 아무것도 쓰지 않았을 때의 로그 창.
plugins-logs-empty = 아직 플러그인 출력이 없습니다

# 호출이 실패한 이유: 연결이 없어 아무것도 보내지 않았습니다.
plugins-problem-offline = 머신이 연결되어 있지 않습니다. 머신이 켜져 있고 Vessel이 실행 중인지 확인하세요.

# 호출이 실패한 이유: 기다리는 동안 연결이 끊겼습니다.
plugins-problem-dropped = 응답을 받기 전에 연결이 끊겼습니다. 요청이 처리되었는지 알 수 없습니다.

# 호출이 실패한 이유: 제시간에 응답이 없었습니다.
plugins-problem-timed-out = 머신이 제시간에 답하지 않았습니다. 요청이 처리되었는지 알 수 없습니다.

# 호출이 실패한 이유: 머신의 Vessel에 그 호출이 없습니다.
plugins-problem-unsupported = 이 머신의 Vessel이 오래되었습니다. 사용하려면 업데이트하세요.

# 노드가 코드만 주고 설명을 주지 않았을 때. $code는 "forbidden" 같은 와이어 코드입니다.
plugins-problem-refused = 머신이 거부했습니다({ $code }).

# 플러그인 화면의 머신이 연결되어 있지 않을 때(Paseo의 "Plugin host is offline.").
plugins-screen-offline = 플러그인 머신이 오프라인입니다.

# 실행 중인 플러그인이 선언하지 않은 플러그인 화면.
plugins-screen-unavailable = 이 플러그인 화면을 쓸 수 없습니다.

# 플러그인 화면을 닫는 버튼(Paseo의 "Close plugin").
plugins-screen-close = 플러그인 닫기

# 그 버튼의 tooltip(Paseo의 "Close"). 버튼 이름은 "플러그인 닫기" 그대로입니다.
plugins-screen-close-tip = 닫기

# 관리자 권한이 없는 기기에서 플러그인 화면 위에 보이는 줄. $machine은 머신 이름입니다.
plugins-screen-read-only = 바꾸려면 { $machine }의 관리자 권한이 필요합니다.
