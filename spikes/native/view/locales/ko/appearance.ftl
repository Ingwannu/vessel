## Appearance follows Paseo settings.appearance. Families are names, never paths.
# Section heading.
appearance-fonts = 글꼴
# Empty family input placeholder; embedded defaults on native desktop.
appearance-default-family = 기본 글꼴
# Interface font row.
appearance-interface-family = 인터페이스 글꼴
# Interface font hint; native defaults use embedded fonts.
appearance-interface-family-hint = 앱 전체에 사용됩니다. 기본 글꼴을 사용하려면 비워 두세요
# Interface size row.
appearance-interface-size = 인터페이스 크기
# Interface size hint.
appearance-interface-size-hint = 탐색, 컨트롤 및 레이블에 사용됩니다
# Independent chat and Markdown size row.
appearance-content-size = 콘텐츠 크기
# Content size hint.
appearance-content-size-hint = 채팅 텍스트와 렌더링된 Markdown에 사용됩니다
# Code font row.
appearance-code-family = 코드 글꼴
# Code font hint.
appearance-code-family-hint = 코드, diff, 터미널 출력에 사용됩니다. 기본 글꼴을 사용하려면 비워 두세요
# Independent code size row.
appearance-code-size = 코드 크기
# Code size hint.
appearance-code-size-hint = 코드, diff 및 터미널 출력에 사용됩니다
# Layout heading.
appearance-layout = 레이아웃
# Maximum content width row.
appearance-width = 콘텐츠 너비
# Width hint.
appearance-width-hint = 와이드 화면에서 채팅과 Markdown 파일의 최대 너비
# Clear explicit width and follow the current default.
appearance-reset-width = 재설정
# Code highlight section.
appearance-syntax = 구문
# Syntax selector label.
appearance-highlight = 강조 테마
# Syntax selector hint.
appearance-highlight-hint = 앱 테마와 독립적인 코드 색상
# Preview's descriptive label.
appearance-preview = 콘텐츠 타이포그래피, 구문 테마, 코드 글꼴의 실시간 미리보기
# Representative preview title.
appearance-preview-content = 콘텐츠 및 코드 미리보기
# Numeric field unit.
appearance-pixels = px
# Syntax option, proper name.
appearance-github = GitHub
# Syntax option, proper name.
appearance-catppuccin = Catppuccin
# Syntax option, proper name.
appearance-dracula = Dracula
# Syntax option, proper name.
appearance-tokyo-night = Tokyo Night
# Syntax option, proper name.
appearance-one = One
# Syntax option, proper name.
appearance-nord = Nord
# Syntax option, proper name.
appearance-gruvbox = Gruvbox
# Syntax option, proper name.
appearance-solarized = Solarized
