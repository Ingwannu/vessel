# 명령 팔레트 검색 범위 버튼. 짧게 유지합니다.
message-search-commands = 명령
# Messages segment label. Keep short.
message-search-messages = 메시지
# 메시지 검색 입력란과 검색어를 입력하기 전 안내입니다.
message-search-placeholder = 모든 세션의 메시지 검색
# Empty Messages scope; instructs the person to enter a query.
message-search-hint = 검색어를 입력해 연결된 모든 머신의 메시지를 찾으세요.
# 검색 결과의 세션이 열기 전에 목록에서 사라졌을 때 표시합니다.
message-search-unavailable = 이 세션을 더 이상 열 수 없습니다. 다시 검색해 주세요.

# Palette action for entering the Messages scope using only the keyboard.
message-search-open = 메시지 검색

# Per-machine palette search recovery. The existing note supplies the source name.
# Whole sentences without variables; never display peer-provided error text.
message-search-timeout = 검색 제한 시간을 초과했습니다. 다시 시도해 주세요.
# Per-machine palette search failure below its source machine name; no variables.
message-search-failed = 이 머신의 메시지를 검색하지 못했습니다. 다시 시도해 주세요.
