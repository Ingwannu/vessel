## Conversation tool details.

# Empty result in a tool detail body, including the compact sheet. Whole short sentence.
timeline-tool-empty = 추가 세부 정보가 없습니다
# Tool detail preview hit the client's line limit; copying retains the full text.
timeline-tool-preview-cut = 미리보기가 잘렸습니다

# Canonical tool category: command execution. Short tool row label.
timeline-tool-shell = 셸
# Canonical tool category: reading a file. Short tool row label.
timeline-tool-read = 읽기
# Canonical tool category: editing an existing file. Short tool row label.
timeline-tool-edit = 편집
# Canonical tool category: writing a complete file. Short tool row label.
timeline-tool-write = 쓰기
# Canonical tool category: searching files or the web. Short tool row label.
timeline-tool-search = 검색
# Canonical tool category: fetching a web resource. Short tool row label.
timeline-tool-fetch = 가져오기
# Canonical tool category: preparing a worktree. Short tool row label.
timeline-tool-setup = 워크트리 준비
# Generic child-agent launch marker. Short tool row label.
timeline-tool-task = 작업
# Proposed Markdown plan. Short tool row label; decision title has its own domain.
timeline-tool-plan = 계획
# Internal reasoning tool. Short tool row label.
timeline-tool-thinking = 추론
# Fallback when a provider supplied no tool name. Short tool row label.
timeline-tool-tool = 도구

# Delivery event category, independent of the receiving tool status. Short row label.
timeline-tool-message-received = 메시지 수신
# Delivery event category, independent of the receiving tool status. Short row label.
timeline-tool-agent-finished = 에이전트 완료
# Delivery event category, independent of the receiving tool status. Short row label.
timeline-tool-agent-errored = 에이전트 오류
# Delivery event category, independent of the receiving tool status. Short row label.
timeline-tool-agent-permission = 에이전트 권한 필요
# Delivery event category, independent of the receiving tool status. Short row label.
timeline-tool-agent-closed = 에이전트 종료
# $id is the original external sender id, display provenance only; never a navigation authority.
timeline-tool-from-agent = 보낸 에이전트: { $id }
