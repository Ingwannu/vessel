## 일반 설정의 언어 선택. 이름은 짧게 쓰세요.
# 이 폴더 언어의 자기 이름.
meta-name = 한국어
# 일반 설정의 언어 행 제목. 짧게.
meta-language = 언어
# 시스템 언어를 따르는 첫 번째 선택. 짧게.
meta-system = 시스템

# General settings language row hint, following Paseo. Keep short.
meta-language-note = 앱 언어

# 선택 컨트롤의 화면 읽기 이름. $field는 필드 이름, $value는 선택한 값.
meta-select-field-name = { $field } ({ $value })

# 호스트 필터의 화면 읽기 이름. $host는 선택한 머신 또는 모든 호스트.
meta-host-filter-name = 필터: { $host }
