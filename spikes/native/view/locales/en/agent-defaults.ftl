## Settings › Providers › defaults: refusal before local preferences change.

# A complete choice list exceeds the existing saved-option contract. No values.
agent-defaults-storage = This device cannot save the selected defaults. Choose another option.

# The option changed while the picker was open. No machine prose or values.
agent-defaults-not-offered = The agent no longer offers this option. The previous defaults are kept.

# Repeated option ids cannot identify one choice. No values.
agent-defaults-conflicting = The agent reported conflicting options. The previous defaults are kept.
