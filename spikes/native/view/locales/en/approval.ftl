# Approval boundary for project allocation fields; complete display alone does not enable the feature.
approval-unseen-service-ports = These service port settings are shown for inspection. Approval support for this configuration is not enabled yet.

# Heading above every current and previously approved allocation choice.
approval-service-ports = Service port allocation

# Label for the complete allocation block in the requested digest.
approval-allocation-current = Current settings

# Label for exact old settings, including a removed block.
approval-allocation-previous = Previously approved settings

# The entire block is absent; do not display a fabricated default port.
approval-allocation-absent = No project allocation override

# One optional choice is absent from a present allocation block.
approval-allocation-not-declared = Not declared

# Label before the inclusive range from the project file.
approval-allocation-range = Port range

# Label before the exact approved helper path; never a resolved runtime filename.
approval-allocation-program = Port allocation program

# Separate approved configuration from runtime and port discovery facts.
approval-allocation-declaration = These declarations do not confirm an allocated port or a listening service.

# Comparison summary for a block-only or lower-precedence choice edit.
approval-allocation-changes = Service port allocation changes are shown below

# An earlier admitted connection cannot authorize a later confirmation.
approval-connection-changed = Refresh commands on the current connection before reviewing or approving them.
