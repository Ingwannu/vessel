## Independent side-question panel. Short action labels; whole translated failures.
# Side panel: title.
side-question-title = Side question

# Side panel: hint.
side-question-hint = Sees recent messages and status from the main conversation. Nothing said here is added to its history.

# Side panel: placeholder.
side-question-placeholder = Ask a side question…

# Side panel: open.
side-question-open = Open side question

# Side panel: close.
side-question-close = Close side question

# Side panel: reset.
side-question-reset = Start over

# Side panel: recover.
side-question-recover = Find current side question

# Side panel: opening.
side-question-opening = Opening side question…

# Side panel: resetting.
side-question-resetting = Starting a new side question…

# Side panel: sending.
side-question-sending = Sending question…

# Side panel: busy.
side-question-busy = Wait for the current operation to finish.

# Side panel: invalid.
side-question-invalid = Enter a question within the message size limit, without control characters.

# Side panel: slash.
side-question-slash = Slash commands are unavailable in side questions.

# Side panel: offline.
side-question-offline = This machine is offline. Reconnect, then find the current side question.

# Side panel: unsupported.
side-question-unsupported = Update this machine to use side questions.

# Side panel: uncertain.
side-question-uncertain = The outcome could not be confirmed. Find the current side question before trying again.

# Side panel: unsent.
side-question-unsent = The request was not sent. Try again.

# Side panel: refused.
side-question-refused = The machine refused this side question.

# Side panel: invalid-reply.
side-question-invalid-reply = The machine returned an invalid side question. Reopen the panel.

# Side panel: exhausted.
side-question-exhausted = Reopen the app before sending another side question.


# Side panel: explicit partial-history notice after retention.
side-question-history-gap = Earlier side messages were removed by this machine’s retention policy. The available history is shown.
