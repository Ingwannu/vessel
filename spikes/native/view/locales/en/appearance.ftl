## Appearance follows Paseo settings.appearance. Families are names, never paths.
# Section heading.
appearance-fonts = Fonts
# Empty family input placeholder; embedded defaults on native desktop.
appearance-default-family = Default font
# Interface font row.
appearance-interface-family = Interface font
# Interface font hint; native defaults use embedded fonts.
appearance-interface-family-hint = Used across the app. Leave empty for the default font
# Interface size row.
appearance-interface-size = Interface size
# Interface size hint.
appearance-interface-size-hint = Used for navigation, controls, and labels
# Independent chat and Markdown size row.
appearance-content-size = Content size
# Content size hint.
appearance-content-size-hint = Used for chat text and rendered Markdown
# Code font row.
appearance-code-family = Code font
# Code font hint.
appearance-code-family-hint = Used in code, diffs, and terminal output. Leave empty for the default font
# Independent code size row.
appearance-code-size = Code size
# Code size hint.
appearance-code-size-hint = Used for code, diffs, and terminal output
# Layout heading.
appearance-layout = Layout
# Maximum content width row.
appearance-width = Content width
# Width hint.
appearance-width-hint = Max width of chat and Markdown files on wide screens
# Clear explicit width and follow the current default.
appearance-reset-width = Reset
# Code highlight section.
appearance-syntax = Syntax
# Syntax selector label.
appearance-highlight = Highlight theme
# Syntax selector hint.
appearance-highlight-hint = Colors for code, independent of the app theme
# Preview's descriptive label.
appearance-preview = Live preview of content typography, syntax theme, and code font
# Representative preview title.
appearance-preview-content = Readable content and code preview
# Numeric field unit.
appearance-pixels = px
# Syntax option, proper name.
appearance-github = GitHub
# Syntax option, proper name.
appearance-catppuccin = Catppuccin
# Syntax option, proper name.
appearance-dracula = Dracula
# Syntax option, proper name.
appearance-tokyo-night = Tokyo Night
# Syntax option, proper name.
appearance-one = One
# Syntax option, proper name.
appearance-nord = Nord
# Syntax option, proper name.
appearance-gruvbox = Gruvbox
# Syntax option, proper name.
appearance-solarized = Solarized

# Native preview preparation failed without changing saved preferences.
appearance-preview-unavailable = Preview unavailable
