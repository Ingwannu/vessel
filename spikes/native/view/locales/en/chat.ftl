## Settings Chat, after Paseo's chat section.
## Three native displays, in the reference order.

# The Settings navigation entry and page title. Keep short.
chat-title = Chat

# The heading above the display card. Keep short.
chat-detail-level = Detail level

# The display picker row. Keep short.
chat-display = Chat display

# The display row hint; a complete description, not a sentence fragment to join.
chat-description = How much of an agent's work the chat shows

# Show the complete conversation. Keep short; distinct from content width.
chat-display-full = Full

# Fold tool calls in the conversation. Keep short.
chat-display-collapse-tools = Collapse tool calls

# Fold work before the final reply of a completed turn. Keep short.
chat-display-collapse-turns = Collapse turns
