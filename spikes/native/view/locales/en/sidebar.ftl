## Sidebar navigation and Settings › Sidebar. Whole labels are shared by
## the rendered row and its settings row; labels must remain short.

# Builtin header actions, in the reference's default order.
sidebar-new-workspace = New workspace
sidebar-history = Sessions
sidebar-search = Search
sidebar-schedules = Schedules
# Optional summary row. The fixed Usage icon is a separate action.
sidebar-usage = Usage

# Settings card headings and descriptions from sidebar-nav-section.tsx.
sidebar-header-title = Header
sidebar-header-description = Choose which items appear at the top of the sidebar and in what order
sidebar-footer-title = Footer
sidebar-footer-description = Choose which rows appear at the bottom of the sidebar and in what order. Add project and the icon row always show
# Accessible names for the two icon-only reorder buttons.
sidebar-move-up = Move up
sidebar-move-down = Move down
