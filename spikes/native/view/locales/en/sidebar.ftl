## Sidebar navigation and Settings › Sidebar. Whole labels are shared by
## the rendered row and its settings row; labels must remain short.

# Builtin header actions, in the reference's default order.
# Header action: create a new workspace; keep short.
sidebar-new-workspace = New workspace
# Header destination: Sessions/history, not archived-only; keep short.
sidebar-history = Sessions
# Header action: open command center search; keep short.
sidebar-search = Search
# Header destination: schedules; keep short.
sidebar-schedules = Schedules
# Optional summary row. The fixed Usage icon is a separate action.
# Optional footer usage summary, distinct from the fixed Usage icon.
sidebar-usage = Usage

# Settings card headings and descriptions from sidebar-nav-section.tsx.
# Settings Sidebar: header inventory card title.
sidebar-header-title = Header
# Settings Sidebar: info tooltip beside Header card title.
sidebar-header-description = Choose which items appear at the top of the sidebar and in what order
# Settings Sidebar: optional footer inventory card title.
sidebar-footer-title = Footer
# Settings Sidebar: info tooltip beside Footer card title; fixed icons are excluded.
sidebar-footer-description = Choose which rows appear at the bottom of the sidebar and in what order. Add project and the icon row always show
# Accessible names for the two icon-only reorder buttons.
# Accessible tooltip/name for the icon-only move-one-place-up button.
sidebar-move-up = Move up
# Accessible tooltip/name for the icon-only move-one-place-down button.
sidebar-move-down = Move down
# A bounded preference edit was refused; retain previous choices.
# Preference bound refusal; previous order and visibility remain saved.
sidebar-navigation-limit = The sidebar settings could not be saved because the item limit was reached.

# Shared workspace-body states; the source state remains explicit.
# Sidebar scrolling body heading; keep short.
sidebar-workspaces = Workspaces
# Workspace body before its first authoritative snapshot.
sidebar-loading = Loading workspaces…
# Workspace body when the selected source host is unavailable; do not imply empty data.
sidebar-offline = Workspace data is unavailable while this host is offline.
# Workspace body after its source request failed; not an empty registry.
sidebar-failed = Workspaces could not be loaded.
# Empty workspace registry heading; keep short.
sidebar-no-projects = No projects yet
# Empty result after active sidebar filters; registry itself may contain items.
sidebar-no-matches = No workspaces match these filters.
# Action removing active sidebar filters to show the full current inventory.
sidebar-clear-filters = Clear filters
# Collapsible section for pinned workspaces; keep short.
sidebar-pinned = Pinned
# Expand the current workspace group in place; keep short.
sidebar-show-more = Show more
# Refold the current workspace group in place; keep short.
sidebar-show-less = Show less
