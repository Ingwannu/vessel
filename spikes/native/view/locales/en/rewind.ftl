## Rewind from a person's message. Reference: Paseo's rewind menu and
## use-rewind-agent-mutation; Vessel rewinds the conversation, not files.

# The person's rewind mark tooltip. Keep short.
rewind-tooltip = Rewind to this message
# Noninteractive warning at the top of its menu.
rewind-warning = This action cannot be undone
# The one mode supported by the node. Keep short.
rewind-conversation = Rewind conversation
# The person's message copy action. Keep short.
rewind-copy-message = Copy message
# Rewind refusal recovery: point. The diagnostic stays in logs.
rewind-problem-point = The selected point cannot be used to rewind this conversation. Choose another message and try again.

# Rewind refusal recovery: access. The diagnostic stays in logs.
rewind-problem-access = This device is not allowed to rewind this conversation.

# Rewind refusal recovery: version. The diagnostic stays in logs.
rewind-problem-version = Update Vessel on this device and the machine before rewinding.

# Rewind refusal recovery: missing. The diagnostic stays in logs.
rewind-problem-missing = This conversation is no longer available.

# Rewind refusal recovery: not ready. The diagnostic stays in logs.
rewind-problem-not-ready = This conversation cannot be rewound right now. Open it again before retrying.

# Rewind refusal recovery: unsupported. The diagnostic stays in logs.
rewind-problem-unsupported = This agent cannot rewind conversations.

# Rewind refusal recovery: agent missing. The diagnostic stays in logs.
rewind-problem-agent-missing = This conversation's agent is not installed on the machine.

# Rewind refusal recovery: start. The diagnostic stays in logs.
rewind-problem-start = The agent could not be started to rewind this conversation. Try again.

# Rewind refusal recovery: unavailable. The diagnostic stays in logs.
rewind-problem-unavailable = The machine cannot rewind this conversation right now. Try again later.

# Rewind refusal recovery: failed. The diagnostic stays in logs.
rewind-failed = Could not confirm the rewind. Open the conversation again before retrying.
