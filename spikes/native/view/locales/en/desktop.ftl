desktop-next = Continue
# First-run setup: finish. Keep concise for the compact dialog.
desktop-finish = Finish
# First-run setup: skip. Keep concise for the compact dialog.
desktop-skip = Skip setup
# First-run setup: connect. Keep concise for the compact dialog.
desktop-connect = Connect a machine to start setup.
# Setup controls stay disabled until the link acknowledges this authenticated host.
desktop-binding = Connecting to the setup host…
# A replaced book alias must never silently redirect the walkthrough.
desktop-host-changed = The setup host changed. Close setup and open it again.
# A client without authenticated native transport cannot act on these controls.
desktop-binding-unavailable = This client cannot configure a native host.
# First-run setup: wait project. Keep concise for the compact dialog.
desktop-wait-project = Wait for the current project operation to finish.
# First-run setup: setup failed. Keep concise for the compact dialog.
desktop-setup-failed = Setup could not move to the requested step. Reopen setup to retry.
# First-run setup: tools unavailable. Keep concise for the compact dialog.
desktop-tools-unavailable = This node does not expose orchestration settings.
# First-run setup: tools note. Keep concise for the compact dialog.
desktop-tools-note = Agent tools, skills and command-line integration are configured on the host.
# First-run setup: open tools. Keep concise for the compact dialog.
desktop-open-tools = Open host settings
# First-run setup: pair phone. Keep concise for the compact dialog.
desktop-pair-phone = Pair another device
# First-run setup: phone note. Keep concise for the compact dialog.
desktop-phone-note = Pair a phone or another computer using this machine's device settings.
# First-run setup: open pairing. Keep concise for the compact dialog.
desktop-open-pairing = Open device pairing

# Setup choice for installing or removing the local CLI only on Continue.
desktop-cli = Command-line integration

# Setup integration status read retry; this action does not install anything.
desktop-retry = Try again

# Compact walkthrough progress; both values are the fixed opening's step positions.
desktop-step-counter = Step { $current } of { $total }
# Walkthrough appearance step description, below its title.
desktop-appearance-note = Let's start by picking a look.
# Walkthrough providers step description; uses the selected setup machine.
desktop-providers-note = Vessel runs the agent CLIs installed on this machine.
# Walkthrough projects step description, above project registration controls.
desktop-projects-note = Choose where your agents will work.

# First-run project effects await authoritative readiness; an idle list is not an acknowledgement.
desktop-projects-pending = Project setup is not ready yet.
