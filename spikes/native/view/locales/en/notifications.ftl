## Settings › Notifications (ADR 0114): how the app tells you about a
## session, in the page's words with "window" for its "tab".

# Section heading above the session rows; keep short. No values.
notifications-sessions = Sessions

# Row label for the alerts select; keep short. No values.
notifications-alerts = Session notifications

# Hint below the alerts select (Paseo's rule: told unless you are on that session). No values.
notifications-alerts-hint = Alerts when a session finishes or needs your input or approval, unless you are looking at it.

# Alerts choice: nothing is told; keep short. No values.
notifications-alerts-off = Off

# Alerts choice: the system's notification, silent; keep short. No values.
notifications-alerts-system = Notifications only

# Alerts choice: the sound only; keep short. No values.
notifications-alerts-sound = Sound only

# Alerts choice: notification and sound; keep short. No values.
notifications-alerts-both = Notifications with sound

# Row label for the window-title count switch; keep short. No values.
notifications-title = Count in the window's title

# Hint below the window-title count switch. No values.
notifications-title-hint = The window's title shows how many sessions changed while you were away.

# Section heading above the system rows; keep short. No values.
notifications-system = This system

# Row label for where system notifications go; keep short. No values.
notifications-delivery = System notifications

# Delivery row on Linux. No values.
notifications-delivery-linux = Shown by the desktop's notification service.

# Delivery row on Windows. No values.
notifications-delivery-windows = Shown as Windows notifications.

# Delivery row where this build has no system notifications (macOS, a browser). No values.
notifications-delivery-none = This build cannot show system notifications here. Sound only is still available.

# Row label for the test button's row; keep short. No values.
notifications-test = Test notification

# Hint below the test row. No values.
notifications-test-hint = Send one with these settings.

# Button that sends a test notification; keep short. No values.
notifications-test-send = Send

# Title of the test system notification. No values.
notifications-test-title = Vessel notification test

# Body of the test system notification. No values.
notifications-test-body = If you can see this, notifications work.

# Toast after the test was handed to the system (Paseo's words). No values.
notifications-test-sent = Test notification sent

# Body of a session notification whose session has no name yet. No values.
notifications-untitled = Untitled session
