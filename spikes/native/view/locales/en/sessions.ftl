# Session navigation feedback.
sessions-navigation-offline = The session’s host is not connected. Reconnect and try the link again.
# Session navigation feedback.
sessions-navigation-refused = The host could not open this session.
# Session navigation feedback.
sessions-navigation-timeout = Opening the session timed out. Try again.
# Session navigation feedback.
sessions-navigation-busy = Another request is being processed. Try again.
# Session navigation feedback.
sessions-link-copied = Session link copied
# A mutation timed out; do not imply it failed before being committed.
sessions-outcome-uncertain = The operation timed out and may have completed. Refresh before retrying.

# Preserve uncertainty when a mutation has no readable node reply.
sessions-reply-uncertain = The operation’s reply was lost or could not be read. It may have completed. Refresh before retrying.
# Fresh conversation refuses to overwrite another unsent draft.
sessions-existing-draft = New chat already has a draft. Open it before starting a fresh conversation.
# Preserve explicit profile configuration until the draft profile picker can carry it.
sessions-profile-unavailable = This session’s profile cannot be carried to a fresh conversation here. The session was kept.
# A late operation may have settled on the old node; never close a replacement destination.
sessions-destination-changed = The session connection changed. Refresh to check the operation before continuing.

# Closing an unknown child must not accidentally archive it.
sessions-parentage-unavailable = Current session parent information is unavailable. Refresh before closing this tab.

# Reopening admits the original node identity before a lifecycle mutation.
sessions-identity-unavailable = This session’s host identity is unavailable. Reopen the session before changing it.
