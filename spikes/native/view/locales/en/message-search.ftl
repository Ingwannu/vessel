# Command palette scope segments. Keep these short.
message-search-commands = Commands
# Messages segment label. Keep short.
message-search-messages = Messages
# Input placeholder and the empty Messages scope before a query is entered.
message-search-placeholder = Search messages across sessions
# Empty Messages scope; instructs the person to enter a query.
message-search-hint = Enter words to search every connected machine’s messages.
# A search result disappeared from the fleet before it could be opened.
message-search-unavailable = This session is no longer available. Refresh the search and try again.

# Palette action for entering the Messages scope using only the keyboard.
message-search-open = Search messages

# Per-machine palette search recovery. The existing note supplies the source name.
# Whole sentences without variables; never display peer-provided error text.
message-search-timeout = Search timed out. Try again.
message-search-failed = This machine could not search its messages. Try again.
